# Absolute path to LISA_Project_Package/data (never committed)
LISA_DATA_DIR=C:/Users/you/Desktop/Adway Con/Final_Project (1)/LISA_Project_Package/data
# Optional: override output dir (default ./out)
# LISA_OUT_DIR=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# min 8 chars (Neo4j requirement)
NEO4J_PASSWORD=change-me-please

# SharedLLM gateway virtual key - the only LLM credential the standard path needs (secret; never commit)
SHAREDLLM_API_KEY=sk-sharedllm-REPLACE-ME
# Optional: own Ollama Cloud key, only for llm.auth bearer / sharedllm_byok (not used by the standard path)
OLLAMA_API_KEY=REPLACE-ME

# Phase 3: HS256 secret that signs agent->MCP tokens (any long random string)
LISA_AUTH_SECRET=REPLACE-WITH-64-RANDOM-CHARS
# CourtListener API token (courtlistener.com profile -> API). Leave empty to demo graceful degradation.
COURTLISTENER_TOKEN=
# OpenTelemetry OTLP/HTTP endpoint (Jaeger all-in-one): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Pre-issued researcher token for the agent container (compose): python scripts/issue_token.py lisa-agent
LISA_AGENT_TOKEN=
